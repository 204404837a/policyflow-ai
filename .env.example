# ---- LLM gateway (LiteLLM → Groq / Hugging Face) ----
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://litellm:4000

# ---- Tracing (PII-scrubbed) ----
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=policyflow-ai

# ---- Host-published ports (left side of host:container in docker-compose) ----
# Change these if the default ports are in use on the host.
WEB_PORT=3000
API_PORT=8000
LITELLM_PORT=4000
POSTGRES_PORT=5432
QDRANT_PORT=16333
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
REDIS_PORT=16379

# ---- Service URLs ----
# Defaults below use in-compose hostnames + CONTAINER ports (what api/worker use
# on the compose network). For LOCAL dev (app run outside docker), point these at
# localhost + the host-published ports above, e.g.:
#   DATABASE_URL=postgresql+asyncpg://policyflow:policyflow@localhost:5432/policyflow
#   QDRANT_URL=http://localhost:16333
#   MINIO_ENDPOINT=localhost:19000
#   REDIS_URL=redis://localhost:16379/0
#   LITELLM_BASE_URL=http://localhost:4000

# ---- Postgres ----
POSTGRES_USER=policyflow
POSTGRES_PASSWORD=policyflow
POSTGRES_DB=policyflow
DATABASE_URL=postgresql+asyncpg://policyflow:policyflow@postgres:5432/policyflow

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=policy_documents

# ---- MinIO (S3-compatible object store) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=policyflow
MINIO_SECURE=false

# ---- Redis (Celery broker + LiteLLM cache) ----
REDIS_URL=redis://redis:6379/0

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
MAX_FILE_MB=10

# Decision thresholds (single-source; do not hardcode in app code)
FRAUD_ESCALATE_THRESHOLD=0.3
MIN_AGENT_CONFIDENCE=0.6
MAX_RETRIES=3
RETRIEVAL_TOP_K=8

# LLM gateway tuning
HTTP_TIMEOUT_S=90
LLM_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_S=0.5
LLM_RETRY_MAX_S=8
BREAKER_FAIL_MAX=5
BREAKER_RESET_S=30

# Vector store
EMBEDDING_DIM=1024
